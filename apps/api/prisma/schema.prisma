// Data model for film-routes. See docs/concept.md for the product context.
//
// Conventions:
//  - Table and column names are snake_case in the database (@@map / @map),
//    camelCase in the Prisma client.
//  - Primary keys are UUID v7 (time-ordered, friendlier to indexes than v4).
//  - Timestamps are timestamptz.
//  - User-facing labels (emotions, statuses) are NOT stored: the web client
//    translates the enum values with its i18n files.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Locale {
  ES
  EN

  @@map("locale")
}

/// PRIVATE: only the author. UNLISTED: reachable through a personal invite.
/// PUBLIC: listed in discovery; anyone can start it.
enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC

  @@map("visibility")
}

/// Keep in sync with EMOTIONS in packages/shared.
enum Emotion {
  JOY
  TENDERNESS
  AWE
  THOUGHTFUL
  TENSION
  FEAR
  SADNESS
  DISCOMFORT

  @@map("emotion")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  /// The traveler left on their own.
  ABANDONED
  /// The route author removed the traveler.
  REMOVED

  @@map("enrollment_status")
}

/// What a single-use emailed link is for.
enum UserTokenPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET

  @@map("user_token_purpose")
}

/// Admins are set by hand in the database and checked there on every request,
/// never read from a token: removing the role takes effect immediately.
enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum ReportReason {
  SPOILER
  OFFENSIVE
  SPAM
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  /// Waiting for an admin.
  OPEN
  /// An admin looked at it and left the route as it was.
  DISMISSED
  /// An admin hid the route because of it.
  UPHELD

  @@map("report_status")
}

// ─── Identity ───────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase; the API normalises before writing.
  username        String    @unique @db.VarChar(30)
  /// Stored lowercase; the API normalises before writing.
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  locale          Locale    @default(ES)
  /// Set when the person opens the link sent to their address. Until then they
  /// can browse and follow routes, but not share, invite, rate or report.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  routes        Route[]        @relation("RouteAuthor")
  routesHidden  Route[]        @relation("RouteHiddenBy")
  invitesIssued RouteInvite[]
  enrollments   Enrollment[]
  refreshTokens RefreshToken[]
  ratings       RouteRating[]
  tokens        UserToken[]
  reportsFiled  RouteReport[]  @relation("ReportReporter")
  reportsClosed RouteReport[]  @relation("ReportResolver")

  @@map("users")
}

/// Rotating refresh tokens. Only a hash is stored, never the token itself.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Single-use links sent by email (verify the address, reset the password).
/// Like refresh tokens and invitations, only a hash is stored, never the token.
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  /// Set when the link is used, so it cannot be used twice.
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Looking up the latest link of a person for a purpose (resend cooldown).
  @@index([userId, purpose, createdAt])
  @@map("user_tokens")
}

// ─── Film catalogue (cache of TMDB data) ────────────────────────────────

model Film {
  id             String   @id @default(uuid(7)) @db.Uuid
  tmdbId         Int      @unique @map("tmdb_id")
  imdbId         String?  @map("imdb_id") @db.VarChar(16)
  originalTitle  String   @map("original_title")
  releaseYear    Int?     @map("release_year")
  runtimeMinutes Int?     @map("runtime_minutes")
  posterPath     String?  @map("poster_path")
  backdropPath   String?  @map("backdrop_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations FilmTranslation[]
  steps        RouteStep[]

  @@map("films")
}

model FilmTranslation {
  filmId   String  @map("film_id") @db.Uuid
  locale   Locale
  title    String
  overview String?

  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([filmId, locale])
  @@map("film_translations")
}

// ─── Routes ─────────────────────────────────────────────────────────────

model Route {
  id          String     @id @default(uuid(7)) @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  /// Language the author wrote title, description and notes in.
  locale      Locale
  title       String     @db.VarChar(120)
  description String?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Set when an admin takes the route down. While set, nobody can find, join
  /// or follow it, and the author cannot publish it again; only an admin can
  /// lift it. It is separate from `visibility` so the author's choice survives.
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(3)
  /// Why it was hidden; shown to the author. Required whenever hiddenAt is set.
  hiddenReason String?   @map("hidden_reason") @db.VarChar(500)
  hiddenById   String?   @map("hidden_by_id") @db.Uuid

  author      User          @relation("RouteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hiddenBy    User?         @relation("RouteHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  steps       RouteStep[]
  invites     RouteInvite[]
  enrollments Enrollment[]
  ratings     RouteRating[]
  reports     RouteReport[]

  @@index([authorId])
  @@index([visibility, createdAt])
  @@map("routes")
}

/// A complaint about a route. One per person and route: asking again would
/// only let one person pile up the count.
model RouteReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  routeId      String       @map("route_id") @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  reason       ReportReason
  /// Optional context from the reporter.
  note         String?      @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(3)
  resolvedById String?      @map("resolved_by_id") @db.Uuid

  route      Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([routeId, reporterId])
  /// The admin queue: open reports, oldest first.
  @@index([status, createdAt])
  @@map("route_reports")
}

/// One score per person and route, from 1 to 10, given after completing it.
/// The route's overall score is the average of these; it is never stored, so
/// it cannot drift out of sync with the votes.
model RouteRating {
  id        String   @id @default(uuid(7)) @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Changing your mind updates the row; it never adds a second vote.
  @@unique([routeId, userId])
  @@map("route_ratings")
}

model RouteStep {
  id            String   @id @default(uuid(7)) @db.Uuid
  routeId       String   @map("route_id") @db.Uuid
  filmId        String   @map("film_id") @db.Uuid
  /// 1-based order inside the route.
  position      Int
  /// Spoiler-free note shown when the step unlocks.
  noteBefore    String?  @map("note_before")
  /// Shown only after the traveler marks the film as watched.
  noteAfter     String?  @map("note_after")
  /// How the author felt: the "you vs them" comparison starts here.
  authorEmotion Emotion? @map("author_emotion")

  route    Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  film     Film           @relation(fields: [filmId], references: [id], onDelete: Restrict)
  progress StepProgress[]

  @@unique([routeId, position])
  @@unique([routeId, filmId])
  @@index([filmId])
  @@map("route_steps")
}

/// Invitation link that several people can use. Only a hash of the token is
/// stored. `maxUses` caps how many people can join with it (null = no cap) and
/// `usesCount` is incremented atomically when someone joins.
model RouteInvite {
  id          String    @id @default(uuid(7)) @db.Uuid
  routeId     String    @map("route_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  maxUses     Int?      @map("max_uses")
  usesCount   Int       @default(0) @map("uses_count")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  route       Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// Everyone who joined through this link.
  enrollments Enrollment[]

  @@index([routeId])
  @@map("route_invites")
}

// ─── Progress ───────────────────────────────────────────────────────────

/// A traveler following a route.
model Enrollment {
  id          String           @id @default(uuid(7)) @db.Uuid
  routeId     String           @map("route_id") @db.Uuid
  travelerId  String           @map("traveler_id") @db.Uuid
  inviteId    String?          @map("invite_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)

  route    Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  traveler User           @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  invite   RouteInvite?   @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  progress StepProgress[]

  /// One enrollment per person and route, whatever its status: a removed
  /// traveler keeps their row (REMOVED) so the same link cannot bring them back.
  @@unique([routeId, travelerId])
  @@index([travelerId])
  @@index([inviteId])
  @@map("enrollments")
}

/// One row per (enrollment, step) once the traveler touches the step.
/// startedAt = "I'm starting it now"; watchedAt = confirmed as watched.
model StepProgress {
  id           String    @id @default(uuid(7)) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  stepId       String    @map("step_id") @db.Uuid
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  watchedAt    DateTime? @map("watched_at") @db.Timestamptz(3)
  /// The traveler had already seen this film before the route; no "start now".
  seenBefore   Boolean   @default(false) @map("seen_before")
  emotion      Emotion?
  /// Short private note; only the traveler and the route author can read it.
  comment      String?   @db.VarChar(280)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       RouteStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepId])
  @@index([stepId])
  @@map("step_progress")
}
