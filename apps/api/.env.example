# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Local database started with `docker compose up -d` at the repo root.
DATABASE_URL=postgresql://film_routes:film_routes@localhost:5432/film_routes

# Secret used to sign access tokens (at least 32 characters). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me

# Access tokens are short-lived; refresh tokens are rotated on every use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
